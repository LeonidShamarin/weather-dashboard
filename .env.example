# Copy to .env and fill in.
# A free key comes from https://openweathermap.org/api (it takes a few minutes
# to activate). Vite inlines every VITE_* value into the client bundle, so this
# key is visible to anyone who opens the site.
VITE_API_URL=https://api.openweathermap.org/data/2.5
VITE_API_KEY=
